NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://eventshare:eventshare@localhost:5433/eventshare

# Login tokens. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=30d

# Clerk (switched off for now) (dashboard -> API keys). AUTH_DEV_BYPASS=true skips Clerk (local tests only; refused in production).
CLERK_SECRET_KEY=
# Local dev only: accept an `x-dev-user: alice` header instead of a Clerk token.
AUTH_DEV_BYPASS=false

# Cache, background jobs and live updates. Leave empty to run without them (everything still works, just slower).
REDIS_URL=redis://localhost:6380

# Local S3 (SeaweedFS, docker compose). On AWS: drop S3_ENDPOINT/keys/path-style and use an IAM role.
S3_REGION=ap-south-1
S3_BUCKET=eventshare-photos
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=eventshare
S3_SECRET_ACCESS_KEY=eventshare-dev-secret
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=3600

# Photographer invite emails via Resend (resend.com). Leave empty to skip sending.
RESEND_API_KEY=
# A sender on a domain verified in Resend.
MAIL_FROM=eventShare <invites@klyra.co.in>
