{
  "expo": {
    "name": "Klickers",
    "slug": "eventshare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eventshare",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "in.co.klyra.eventshare",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "15",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:klickers.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.co.klyra.eventshare",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "klickers.app",
              "pathPrefix": "/j/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Klickers uses your camera to take photos and videos for the events you join.",
          "microphonePermission": "Klickers uses the microphone for voice notes and the sound of your videos at the events you join.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Klickers needs access to your photos so you can add them to an event gallery.",
          "cameraPermission": "Klickers uses your camera to take photos and videos for the events you join.",
          "microphonePermission": "Klickers uses the microphone for voice notes and the sound of your videos at the events you join."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Klickers needs access to your photos so you can add them to an event gallery.",
          "savePhotosPermission": "Klickers saves photos you download from an event to your library.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1013281717078-4vo32npedk2cd9nuovbqj49nrevli021"
        }
      ],
      "./plugins/with-release-signing",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Klickers uses the microphone for voice notes and the sound of your videos at the events you join."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
